begin
  UninstallKey := 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{48E2C137-8DC0-46E6-9209-5EBEF77E5F62}_is1';
  UninstallString := '';
  if not RegQueryStringValue(HKCU, UninstallKey, 'UninstallString', UninstallString) then
  begin
